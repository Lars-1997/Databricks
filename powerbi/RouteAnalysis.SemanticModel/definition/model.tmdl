model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: de-DE
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Datum","Trips","Zones Pickup","Zones Dropoff","Weather"]

annotation PBI_ProTooling = ["DevMode"]

ref table Datum
ref table Trips
ref table 'Zones Pickup'
ref table 'Zones Dropoff'
ref table Weather

ref cultureInfo en-US

